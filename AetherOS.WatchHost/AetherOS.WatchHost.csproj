<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PROTOTYPE. Owns CEF so the game process never has to: a browser crash kills this and nothing else,
    and no native browser binaries are loaded into Dalamud's assembly load context.

    Deliberately a separate exe rather than a library. CEF is multi-process by design and fights being
    hosted inside somebody else's render loop.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>AetherOS.WatchHost</AssemblyName>
    <RootNamespace>AetherOS.WatchHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Matching the version a shipping in-game browser plugin (Browsingway) runs, rather than whatever
         NuGet offered first: 120 carries known CVEs and this is a browser. -->
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="143.0.90" />
  </ItemGroup>
</Project>
