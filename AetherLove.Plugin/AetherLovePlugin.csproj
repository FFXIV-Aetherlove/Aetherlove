<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.5.0.0</Version>
    <!-- Windows-versioned TFM so the Windows SDK projection resolves: Groove's media backend reads
         GSMTC (Windows.Media.Control). 17763 = Windows 10 1809, where GSMTC first shipped. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Authors>Astraea, Nihal</Authors>
    <Company>Astraea</Company>
    <Copyright>Copyright © 2026 Astraea</Copyright>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <!--
    Dalamud manifest fields. DalamudPackager reads these MSBuild properties at build
    time and writes them into the output AetherLove.json (overriding any same-named
    field in the committed source manifest). InternalName defaults to the assembly
    name (AetherLovePlugin) and must stay matching the built DLL.
  -->
  <PropertyGroup>
    <Name>AetherLove</Name>
    <Author>Astraea, Nihal</Author>
    <Punchline>Swipe for joy.</Punchline>
    <Description>FFXIV in-game dating and matchmaking — swipe, match, and chat with other adventurers. /love opens the phone.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <Tags>dating;social;matchmaking;chat</Tags>
    <RepoUrl>https://github.com/FFXIV-Aetherlove/Aetherlove</RepoUrl>
    <PackageProjectUrl>https://github.com/FFXIV-Aetherlove/Aetherlove</PackageProjectUrl>
    <IconUrl>https://aetherlove.space/logo_mini.png</IconUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Media\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Echo's browser host. Built so a developer can point Configuration.Echo.HostPathOverride at the output,
    but deliberately NOT referenced and NOT copied: shipped installs download it at runtime, and its CEF
    assemblies must never enter the plugin's load context. ReferenceOutputAssembly false gives the build
    ordering without the reference.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AetherOS.WatchHost\AetherOS.WatchHost.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="none"
                      Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Windows.Extensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.10" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- D3D11/DXGI interop for the in-game screen capture; ships with Dalamud (used by FFXIVClientStructs),
         referenced compile-time only so we bind against the runtime copy. -->
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AetherLove.Shared\AetherLove.Shared.csproj" />
    <ProjectReference Include="..\AetherLove.AppKit\AetherLove.AppKit.csproj" />
    <ProjectReference Include="..\AetherLove.Core\AetherLove.Core.csproj" />
    <ProjectReference Include="..\AetherOS.Sdk\AetherOS.Sdk.csproj" />
    <ProjectReference Include="..\AetherOS.Apps.Love\AetherOS.Apps.Love.csproj" />
    <ProjectReference Include="..\AetherOS.Apps.Settings\AetherOS.Apps.Settings.csproj" />
    <ProjectReference Include="..\AetherOS.Apps.Camera\AetherOS.Apps.Camera.csproj" />
    <ProjectReference Include="..\AetherOS.Apps.Clock\AetherOS.Apps.Clock.csproj" />
    <ProjectReference Include="..\AetherOS.Apps.Snake\AetherOS.Apps.Snake.csproj" />
